// Committed identity for the Semreh fork (MauriceAK Apple Developer account).
// Config/Local.xcconfig may still override these values for contributor builds.
DEVELOPMENT_TEAM = XXXXXXXXXX
APP_IDENTIFIER_SUFFIX =
APP_BUNDLE_IDENTIFIER = com.mauriceak.semreh$(APP_IDENTIFIER_SUFFIX)
APP_GROUP_IDENTIFIER = group.com.mauriceak.semreh$(APP_IDENTIFIER_SUFFIX)
